# 운영(Vercel)에서는 Neon 연동이 DATABASE_URL을 자동으로 넣습니다.
# 로컬 개발 서버(npm run dev)는 DATABASE_URL이 있어도 내장 Postgres(PGlite, .data/pglite)를 씁니다.
# 로컬에서 원격 DB에 붙어야 할 때만 RFT_USE_REMOTE_DB=1을 함께 줍니다.
# DATABASE_URL=
# RFT_USE_REMOTE_DB=1

# 앱 내부 AI 호출 상한 (과금 사고 방지용 안전장치)
# AI_CAP_PER_DAY=200
# AI_CAP_PER_PROJECT=100

# OpenAI·ChatGPT 키나 토큰은 여기에 넣지 않습니다. 실행기가 PC의 보호 저장소에만 보관합니다.
